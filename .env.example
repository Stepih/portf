# Шаблон переменных окружения. Скопируйте в .env.local и заполните.
# .env.local в git не попадает. На проде те же переменные задаются в env Docker-контейнера.
#
# Без них /api/sendMessage отвечает 500 и пишет ошибку в лог.

# Токен Telegram-бота, через которого /api/sendMessage пересылает заявки (выдаёт @BotFather)
TELEGRAM_BOT_TOKEN=

# ID чата, куда приходят заявки
TELEGRAM_CHAT_ID=

# Ключ BotHub для демо-чата /api/chat (OpenAI-совместимый API, https://openai.bothub.chat/v1).
# Выпускается в личном кабинете bothub.chat. Без него чат отвечает ошибкой
BOTHUB_API_KEY=

# Адрес OpenAI-совместимого API BotHub
BOTHUB_BASE_URL=https://openai.bothub.chat/v1
