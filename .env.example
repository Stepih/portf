# Шаблон переменных окружения. Скопируйте в .env.local и заполните.
# .env.local в git не попадает. На проде те же переменные задаются в настройках проекта Vercel
# (Settings → Environment Variables) или в env Docker-контейнера.
#
# Без них /api/sendMessage отвечает 500 и пишет ошибку в лог.

# Токен Telegram-бота, через которого /api/sendMessage пересылает заявки (выдаёт @BotFather)
TELEGRAM_BOT_TOKEN=

# ID чата, куда приходят заявки
TELEGRAM_CHAT_ID=

# Ключ BotHub для демо-чата /api/chat (OpenAI-совместимый API, https://openai.bothub.chat/v1).
# Выпускается в личном кабинете bothub.chat. Без него чат отвечает ошибкой
BOTHUB_API_KEY=

# Адрес OpenAI-совместимого API BotHub
BOTHUB_BASE_URL=https://openai.bothub.chat/v1

# Redis для защиты демо-чата от накрутки (CONVERSION_PLAN К3.2): лимиты по IP и бюджет на сутки, общие для
# всех экземпляров функции. На Vercel обязателен – без него чат отвечает 500. Подключается в Vercel:
# Storage / Marketplace → Upstash Redis (бесплатный тариф), переменные проставятся сами – UPSTASH_REDIS_REST_*
# или KV_REST_API_*, подходят обе пары. Локально можно не задавать: счётчики живут в памяти процесса
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
