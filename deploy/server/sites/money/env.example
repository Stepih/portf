# /opt/sites/money/.env – создаётся deploy.ps1 -Site money -Domain <домен> при первом деплое со случайными секретами.
# Секреты Strapi потом не менять: сломаются входы и зашифрованные данные.

# Основной домен сайта без www; Strapi – на cms.<домен>
DOMAIN=

DB_USER=strapi
DB_PASSWORD=change_me
DB_NAME=strapi

JWT_SECRET=change_me
ADMIN_JWT_SECRET=change_me
API_TOKEN_SALT=change_me
TRANSFER_TOKEN_SALT=change_me
ENCRYPTION_KEY=change_me
APP_KEYS=change_me,change_me,change_me,change_me
REVALIDATE_SECRET=change_me
MODERATION_EMAILS=

# Почта: пусто – письма уходят в MailDev (ssh -L 1080:127.0.0.1:1080 root@<сервер>, затем http://localhost:1080)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=
DEFAULT_REPLY_TO=

# Пока нет HTTPS-сертификата – true, иначе вход не сохранит cookie. После cert.sh – false
SESSION_COOKIE_INSECURE=true

# S3 (Beget) – обязательны для загрузок; при первом деплое берутся из локального money/.env
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ACCESS_KEY_ID_PUBLIC=
AWS_SECRET_ACCESS_KEY_PUBLIC=
AWS_REGION=ru-1
AWS_ENDPOINT=https://s3.ru1.storage.beget.cloud
AWS_BUCKET_PUBLIC=
AWS_BUCKET_PRIVATE=
